# Application Configuration
PROJECT_NAME="Lenny Growth Assistant"
ENVIRONMENT=development
DEBUG=true

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5433/lenny_growth
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@localhost:5433/lenny_growth

# Embedding Model (FastEmbed local engine, 384 dimensions)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# LLM Providers (for future features)
OLLAMA_BASE_URL=http://localhost:11434
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GROQ_API_KEY=your-groq-api-key-here
